// Shares the same schema as the backend – re-used here for the oracle service.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  walletAddress String? @unique @map("wallet_address") @db.VarChar(42)
  role        String @default("user") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  healthScores    HealthScore[]
  insurancePolicies InsurancePolicy[]

  // Unused fields kept minimal for the oracle
  @@map("users")
}

model HealthScore {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  scoreDate          DateTime @map("score_date") @db.Date
  overallScore       Int      @map("overall_score")
  stepsScore         Int?     @map("steps_score")
  activityScore      Int?     @map("activity_score")
  sleepScore         Int?     @map("sleep_score")
  heartScore         Int?     @map("heart_score")
  trend              String?  @db.VarChar(20)
  syncedToBlockchain Boolean  @default(false) @map("synced_to_blockchain")
  blockchainTxHash   String?  @map("blockchain_tx_hash") @db.VarChar(66)
  aiRiskScore        Int?     @map("ai_risk_score")
  aiRiskCategory     String?  @map("ai_risk_category") @db.VarChar(20)
  aiConfidence       Decimal? @map("ai_confidence") @db.Decimal(5, 4)
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scoreDate])
  @@index([userId, scoreDate(sort: Desc)])
  @@map("health_scores")
}

model InsurancePolicy {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  policyNumber    String   @unique @map("policy_number") @db.VarChar(50)
  tokenId         Int?     @unique @map("token_id")
  basePremium     Decimal  @map("base_premium") @db.Decimal(10, 2)
  coverageAmount  Decimal  @map("coverage_amount") @db.Decimal(12, 2)
  coverageTier    Int      @default(1) @map("coverage_tier")
  policyType      String   @default("health") @map("policy_type") @db.VarChar(50)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String   @default("pending") @db.VarChar(20)
  blockchainTxHash String? @map("blockchain_tx_hash") @db.VarChar(66)
  ipfsHash        String?  @map("ipfs_hash") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User @relation(fields: [userId], references: [id])
  policyUpdates PolicyUpdate[]

  @@index([userId])
  @@index([tokenId])
  @@map("insurance_policies")
}

model PolicyUpdate {
  id                 String   @id @default(uuid()) @db.Uuid
  policyId           String   @map("policy_id") @db.Uuid
  healthScore        Int      @map("health_score")
  discountPercentage Decimal  @map("discount_percentage") @db.Decimal(5, 2)
  newPremium         Decimal  @map("new_premium") @db.Decimal(10, 2)
  coverageTier       Int      @map("coverage_tier")
  oracleTxHash       String?  @map("oracle_tx_hash") @db.VarChar(66)
  updatedAt          DateTime @default(now()) @map("updated_at")

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("policy_updates")
}

model OracleLog {
  id           String   @id @default(uuid()) @db.Uuid
  policyId     String?  @map("policy_id") @db.Uuid
  status       String   @db.VarChar(20)
  errorMessage String?  @map("error_message")
  txHash       String?  @map("tx_hash") @db.VarChar(66)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("oracle_logs")
}

