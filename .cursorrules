**Wearable Data Fetching Logic**:
```typescript
// Pseudo-code for data sync
async function syncWearableData(userId: string, provider: string) {
    // 1. Get valid access token (refresh if expired)
    const connection = await getWearableConnection(userId, provider);
    const accessToken = await ensureValidToken(connection);
    
    // 2. Fetch data from provider API
    const healthData = await fetchFromProvider(provider, accessToken, {
        startDate: connection.last_sync_at || thirtyDaysAgo(),
        endDate: now()
    });
    
    // 3. Transform and store data
    const normalized = normalizeHealthData(healthData, provider);
    await storeHealthMetrics(userId, normalized);
    
    // 4. Update last sync timestamp
    await updateLastSync(connection.id);
    
    // 5. Recalculate health score
    await recalculateHealthScore(userId);
}
```

**Module 3: Health Metrics & Scoring**

**Endpoints**:
```
GET    /api/health/metrics           - Get user's health metrics (filtered by date)
GET    /api/health/score             - Get current health score
GET    /api/health/score/history     - Get health score history
GET    /api/health/summary           - Get aggregated health summary
GET    /api/health/trends            - Get trend analysis
POST   /api/health/goals             - Set health goals
GET    /api/health/recommendations   - Get personalized recommendations
```

**Database Schema**:
```sql
CREATE TABLE health_metrics (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    metric_date DATE NOT NULL,
    steps INTEGER DEFAULT 0,
    active_minutes INTEGER DEFAULT 0,
    distance_km DECIMAL(10,2) DEFAULT 0,
    calories_burned INTEGER DEFAULT 0,
    sleep_hours DECIMAL(4,2) DEFAULT 0,
    resting_heart_rate INTEGER,
    weight_kg DECIMAL(5,2),
    created_at TIMESTAMP DEFAULT NOW(),
    UNIQUE(user_id, metric_date)
);

CREATE INDEX idx_health_metrics_user_date ON health_metrics(user_id, metric_date DESC);

CREATE TABLE health_scores (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    score_date DATE NOT NULL,
    overall_score INTEGER NOT NULL CHECK (overall_score >= 0 AND overall_score <= 100),
    steps_score INTEGER CHECK (steps_score >= 0 AND steps_score <= 100),
    activity_score INTEGER CHECK (activity_score >= 0 AND activity_score <= 100),
    sleep_score INTEGER CHECK (sleep_score >= 0 AND sleep_score <= 100),
    heart_score INTEGER CHECK (heart_score >= 0 AND heart_score <= 100),
    trend VARCHAR(20), -- 'improving', 'stable', 'declining'
    created_at TIMESTAMP DEFAULT NOW(),
    UNIQUE(user_id, score_date)
);

CREATE INDEX idx_health_scores_user_date ON health_scores(user_id, score_date DESC);
```

**Health Score Algorithm**:
```typescript
interface HealthScoreWeights {
    steps: number;        // 0.25
    activity: number;     // 0.30
    sleep: number;        // 0.25
    heartRate: number;    // 0.20
}

interface UserMetrics {
    steps: number;
    activeMinutes: number;
    sleepHours: number;
    restingHeartRate: number;
    age: number;
}

function calculateHealthScore(metrics: UserMetrics, weights: HealthScoreWeights): number {
    // 1. Calculate individual metric scores (0-100)
    const stepsScore = calculateStepsScore(metrics.steps, metrics.age);
    const activityScore = calculateActivityScore(metrics.activeMinutes, metrics.age);
    const sleepScore = calculateSleepScore(metrics.sleepHours);
    const heartScore = calculateHeartRateScore(metrics.restingHeartRate, metrics.age);
    
    // 2. Apply weights and calculate overall score
    const overallScore = 
        (stepsScore * weights.steps) +
        (activityScore * weights.activity) +
        (sleepScore * weights.sleep) +
        (heartScore * weights.heartRate);
    
    // 3. Round to nearest integer
    return Math.round(overallScore);
}

// Steps scoring (age-adjusted)
function calculateStepsScore(steps: number, age: number): number {
    const target = getStepsTarget(age); // e.g., 10000 for adults, 8000 for seniors
    const ratio = steps / target;
    
    if (ratio >= 1.2) return 100;  // Exceeds target by 20%
    if (ratio >= 1.0) return 90 + (ratio - 1) * 50; // 90-100
    if (ratio >= 0.7) return 60 + (ratio - 0.7) * 100; // 60-90
    if (ratio >= 0.5) return 30 + (ratio - 0.5) * 150; // 30-60
    return ratio * 60; // 0-30
}

// Similar functions for activity, sleep, heart rate...
```

