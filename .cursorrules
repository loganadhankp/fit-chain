**Module 5: Oracle Service**

**Purpose**: Background service that reads health scores and updates blockchain

**Service Logic**:
```typescript
// Cron job runs every 24 hours
async function oracleUpdateJob() {
    const policies = await getActivePolicies();
    
    for (const policy of policies) {
        try {
            // 1. Get latest health score for user
            const latestScore = await getLatestHealthScore(policy.user_id);
            
            if (!latestScore || !shouldUpdate(policy.last_oracle_update)) {
                continue;
            }
            
            // 2. Sign the data
            const message = ethers.solidityPackedKeccak256(
                ['uint256', 'uint256', 'uint256'],
                [policy.token_id, latestScore.overall_score, Date.now()]
            );
            const signature = await oracleWallet.signMessage(ethers.getBytes(message));
            
            // 3. Submit to blockchain
            const tx = await oracleContract.fulfillHealthUpdate(
                policy.token_id,
                latestScore.overall_score,
                signature
            );
            
            await tx.wait();
            
            // 4. Log the update
            await logPolicyUpdate(policy.id, latestScore, tx.hash);
            
            console.log(`Updated policy ${policy.policy_number}: score ${latestScore.overall_score}`);
            
        } catch (error) {
            console.error(`Failed to update policy ${policy.policy_number}:`, error);
            await logOracleError(policy.id, error);
        }
        
        // Rate limit: wait between transactions
        await sleep(5000);
    }
}

function shouldUpdate(lastUpdate: Date): boolean {
    const hoursSinceUpdate = (Date.now() - lastUpdate.getTime()) / (1000 * 60 * 60);
    return hoursSinceUpdate >= 24;
}
```

