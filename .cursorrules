**UI Flow**:
```typescript
// Example OAuth flow
async function connectFitbit() {
    setLoading(true);
    try {
        // 1. Get OAuth URL from backend
        const { authUrl } = await api.get('/api/wearables/auth-url/fitbit');
        
        // 2. Open OAuth window
        const width = 500;
        const height = 600;
        const left = window.screenX + (window.outerWidth - width) / 2;
        const top = window.screenY + (window.outerHeight - height) / 2;
        
        const popup = window.open(
            authUrl,
            'Fitbit OAuth',
            `width=${width},height=${height},left=${left},top=${top}`
        );
        
        // 3. Listen for callback
        const handleCallback = async (event: MessageEvent) => {
            if (event.data.type === 'oauth_success') {
                window.removeEventListener('message', handleCallback);
                popup?.close();
                
                // Fetch updated connections
                await refetchConnections();
                toast.success('Fitbit connected successfully!');
            }
        };
        
        window.addEventListener('message', handleCallback);
        
    } catch (error) {
        toast.error('Failed to connect Fitbit');
        console.error(error);
    } finally {
        setLoading(false);
    }
}
```

