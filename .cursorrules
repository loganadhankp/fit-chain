        await page.waitForSelector('text=Minting in progress', { timeout: 5000 });
        await page.waitForSelector('text=Policy minted successfully', { timeout: 30000 });
        
        // 7. View NFT
        await expect(page.locator('text=Token ID')).toBeVisible();
        await expect(page.locator('text=Coverage Tier')).toBeVisible();
    });
});
