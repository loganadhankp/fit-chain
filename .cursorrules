### 4. Security & Privacy Implementation

#### Data Encryption

**At Rest**:
```typescript
// Encrypt sensitive data before storing in database
import crypto from 'crypto';

const ENCRYPTION_KEY = process.env.ENCRYPTION_KEY!; // 32 bytes
const ALGORITHM = 'aes-256-gcm';

function encrypt(text: string): { encrypted: string; iv: string; authTag: string } {
    const iv = crypto.randomBytes(16);
    const cipher = crypto.createCipheriv(ALGORITHM, Buffer.from(ENCRYPTION_KEY, 'hex'), iv);
    
    let encrypted = cipher.update(text, 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    
    return {
        encrypted,
        iv: iv.toString('hex'),
        authTag: authTag.toString('hex')
    };
}

function decrypt(encrypted: string, iv: string, authTag: string): string {
    const decipher = crypto.createDecipheriv(
        ALGORITHM,
        Buffer.from(ENCRYPTION_KEY, 'hex'),
        Buffer.from(iv, 'hex')
    );
    
    decipher.setAuthTag(Buffer.from(authTag, 'hex'));
    
    let decrypted = decipher.update(encrypted, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return decrypted;
}

// Usage
const token = await getWearableToken(userId);
const { encrypted, iv, authTag } = encrypt(token);
await db.wearableConnections.update({
    where: { id },
    data: { access_token: encrypted, iv, auth_tag: authTag }
});
```

**In Transit**:
- Enforce HTTPS/TLS 1.3 for all API endpoints
- Use secure WebSocket connections (WSS) for real-time updates
- Certificate pinning in mobile apps

#### GDPR/HIPAA Compliance Features

**Consent Management**:
```typescript
interface ConsentRecord {
    userId: string;
    consentType: 'data_collection' | 'data_sharing' | 'marketing' | 'research';
    granted: boolean;
    timestamp: Date;
    ipAddress: string;
    userAgent: string;
}

// Log all consent changes
async function updateConsent(userId: string, consentType: string, granted: boolean) {
    await db.consents.create({
        data: {
            user_id: userId,
            consent_type: consentType,
            granted,
            ip_address: req.ip,
            user_agent: req.headers['user-agent'],
            timestamp: new Date()
        }
    });
}
```

**Right to be Forgotten**:
```typescript
async function deleteUserData(userId: string) {
    // 1. Delete personal data from database
    await db.healthMetrics.deleteMany({ where: { user_id: userId } });
    await db.healthScores.deleteMany({ where: { user_id: userId } });
    await db.wearableConnections.deleteMany({ where: { user_id: userId } });
    
    // 2. Anonymize policy records (keep for audit but remove PII)
    await db.insurancePolicies.updateMany({
        where: { user_id: userId },
        data: {
            user_id: 'DELETED_USER',
            status: 'cancelled'
        }
    });
    
    // 3. Revoke blockchain policy (if applicable)
    const policies = await getUserPolicies(userId);
    for (const policy of policies) {
        if (policy.token_id) {
            await revokeNFTPolicy(policy.token_id);
        }
    }
    
    // 4. Delete user account
    await db.users.delete({ where: { id: userId } });
    
    // 5. Log deletion for audit
    await logDataDeletion(userId);
}
```

**Data Access Logging**:
```typescript
// Middleware to log all health data access
async function auditLogMiddleware(req: Request, res: Response, next: NextFunction) {
    const sensitiveRoutes = ['/api/health', '/api/policies'];
    
    if (sensitiveRoutes.some(route => req.path.startsWith(route))) {
        await db.auditLogs.create({
            data: {
                user_id: req.user.id,
                action: req.method,
                resource: req.path,
                ip_address: req.ip,
                timestamp: new Date(),
                success: true // Updated after response
            }
        });
    }
    
    next();
}
```

### 5. Testing Strategy

#### Smart Contract Tests (Hardhat)

```typescript
// test/HealthInsuranceNFT.test.ts
import { expect } from "chai";
import { ethers } from "hardhat";

describe("HealthInsuranceNFT", function () {
    let nftContract: any;
    let owner: any, oracle: any, user: any;
    
    beforeEach(async function () {
        [owner, oracle, user] = await ethers.getSigners();
        
        const HealthInsuranceNFT = await ethers.getContractFactory("HealthInsuranceNFT");
        nftContract = await HealthInsuranceNFT.deploy();
        await nftContract.waitForDeployment();
        
        // Add oracle
        await nftContract.addOracle(oracle.address);
    });
    
    describe("Minting", function () {
        it("Should mint a new policy NFT", async function () {
            const basePremium = ethers.parseEther("0.1");
            const ipfsHash = "QmTest123";
            
            await expect(nftContract.mintPolicy(user.address, basePremium, ipfsHash))
                .to.emit(nftContract, "PolicyMinted")
                .withArgs(1, user.address, basePremium);
            
            expect(await nftContract.ownerOf(1)).to.equal(user.address);
            
            const policy = await nftContract.policies(1);
            expect(policy.basePremium).to.equal(basePremium);
            expect(policy.healthScore).to.equal(0); // Initial score
            expect(policy.isActive).to.be.true;
        });
        
        it("Should not allow non-owner to mint", async function () {
            await expect(
                nftContract.connect(user).mintPolicy(user.address, ethers.parseEther("0.1"), "hash")
            ).to.be.reverted;
        });
    });
    
    describe("Health Score Updates", function () {
        beforeEach(async function () {
            await nftContract.mintPolicy(user.address, ethers.parseEther("0.1"), "hash");
        });
        
        it("Should update health score via oracle", async function () {
            const newScore = 85;
            
            await expect(nftContract.connect(oracle).updateHealthScore(1, newScore))
                .to.emit(nftContract, "HealthScoreUpdated")
                .withArgs(1, 0, newScore);
            
            const policy = await nftContract.policies(1);
            expect(policy.healthScore).to.equal(newScore);
        });
        
        it("Should not allow non-oracle to update health score", async function () {
            await expect(
                nftContract.connect(user).updateHealthScore(1, 85)
            ).to.be.revertedWith("Not authorized oracle");
        });
        
        it("Should enforce rate limit on updates", async function () {
            await nftContract.connect(oracle).updateHealthScore(1, 85);
            
            // Try to update again immediately
            await expect(
                nftContract.connect(oracle).updateHealthScore(1, 90)
            ).to.be.revertedWith("Update too frequent");
        });
    });
    
    describe("Premium Calculations", function () {
        it("Should calculate correct discount for high health score", async function () {
            await nftContract.mintPolicy(user.address, ethers.parseEther("1.0"), "hash");
            await nftContract.connect(oracle).updateHealthScore(1, 90);
            
            const currentPremium = await nftContract.getCurrentPremium(1);
            // 90+ score = 20% discount
            expect(currentPremium).to.equal(ethers.parseEther("0.8"));
        });
        
        it("Should calculate no discount for low health score", async function () {
            await nftContract.mintPolicy(user.address, ethers.parseEther("1.0"), "hash");
            await nftContract.connect(oracle).updateHealthScore(1, 40);
            
            const currentPremium = await nftContract.getCurrentPremium(1);
            expect(currentPremium).to.equal(ethers.parseEther("1.0"));
        });
    });
    
    describe("Gas Optimization", function () {
        it("Should use reasonable gas for minting", async function () {
            const tx = await nftContract.mintPolicy(
                user.address,
                ethers.parseEther("0.1"),
                "hash"
            );
            const receipt = await tx.wait();
            
            console.log(`Mint gas used: ${receipt.gasUsed.toString()}`);
            expect(receipt.gasUsed).to.be.lessThan(200000); // Set reasonable limit
        });
    });
});
```

#### Backend API Tests (Jest + Supertest)

```typescript
// tests/api/health.test.ts
import request from 'supertest';
import app from '../src/app';
import { db } from '../src/lib/db';

describe('Health API', () => {
    let authToken: string;
    let userId: string;
    
    beforeAll(async () => {
        // Setup test user
        const res = await request(app)
            .post('/api/auth/register')
            .send({
                email: 'test@example.com',
                password: 'Test123!@#',
                firstName: 'Test',
                lastName: 'User'
            });
        
        authToken = res.body.token;
        userId = res.body.user.id;
    });
    
    afterAll(async () => {
        await db.users.delete({ where: { id: userId } });
    });
    
    describe('GET /api/health/score', () => {
        it('should return current health score', async () => {
            // Insert test data
            await db.healthScores.create({
                data: {
                    user_id: userId,
                    score_date: new Date(),
                    overall_score: 85,
                    steps_score: 90,
                    activity_score: 80,
                    sleep_score: 85,
                    heart_score: 85
                }
            });
            
            const res = await request(app)
                .get('/api/health/score')
                .set('Authorization', `Bearer ${authToken}`);
            
            expect(res.status).toBe(200);
            expect(res.body.overall_score).toBe(85);
            expect(res.body).toHaveProperty('steps_score');
        });
        
        it('should return 401 without auth token', async () => {
            const res = await request(app).get('/api/health/score');
            expect(res.status).toBe(401);
        });
    });
    
    describe('POST /api/health/metrics', () => {
        it('should store health metrics', async () => {
            const metrics = {
                metricDate: '2024-01-15',
                steps: 10000,
                activeMinutes: 45,
                sleepHours: 7.5,
                restingHeartRate: 65
            };
            
            const res = await request(app)
                .post('/api/health/metrics')
                .set('Authorization', `Bearer ${authToken}`)
                .send(metrics);
            
            expect(res.status).toBe(201);
            expect(res.body.steps).toBe(10000);
            
            // Verify in database
            const stored = await db.healthMetrics.findFirst({
                where: {
                    user_id: userId,
                    metric_date: new Date('2024-01-15')
                }
            });
            
            expect(stored).toBeTruthy();
            expect(stored?.steps).toBe(10000);
        });
    });
});
```

